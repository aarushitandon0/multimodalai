# Rostrum - Track C: Contrastive Speech Analytics & Temporal Flaw Grounding
#
# Every target runs with PYTHONHASHSEED=0 so that any result whose ordering
# touches hash() of a string is reproducible (CLAUDE.md invariant 13).
#
# Two environments are required and deliberately kept apart:
#   * the pip venv in .venv  - everything except alignment
#   * the conda env "mfa"    - Montreal Forced Aligner only (see environment.mfa.yml)
# MFA pins old versions of numpy/kaldi-adjacent packages; mixing the two
# environments is the single most common way to break this project.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

export PYTHONHASHSEED := 0
export PYTHONPATH := src

VENV       := .venv
# Annotator names for `make annotate-prepare`, primary first (spec 6.2).
ANNOTATORS ?= annotator1 annotator2
# Extra flags for `make features` / `make feature-demo`, e.g.
#   make features FEATURE_ARGS="--crosscheck --refresh"
FEATURE_ARGS   ?=
DEMO_ARGS      ?=
# e.g. make components COMPONENT_ARGS="--seconds 30 --model tiny"
COMPONENT_ARGS ?=
# Extra flags for `make eval` / `make ablations`, e.g.
#   make eval EVAL_ARGS="--corpus dataset"
EVAL_ARGS      ?=
ifeq ($(OS),Windows_NT)
  PY       := $(VENV)/Scripts/python.exe
  BIN      := $(VENV)/Scripts
else
  PY       := $(VENV)/bin/python
  BIN      := $(VENV)/bin
endif
PYTHON     ?= python3.11
MFA_ENV    := mfa
PORT_API   ?= 8000
PORT_APP   ?= 8501

SRC := src tests eval scripts app

.PHONY: help setup setup-mfa lock data download provenance features envelope eval components \
        ablations figures failures app app-remote api api-docs dashboard-figures test lint \n        format reproduce demo clean clean-cache \
        qc qc-report package package-check feature-demo features-sample cards examples \
        check-env smoke-align mfa-version align align-report build-clean inject \
        envelope-synthetic tuning classifier rubric

## ---------------------------------------------------------------------------
## Help
## ---------------------------------------------------------------------------

help: ## Show this help
	@echo "Rostrum targets:"
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) \
	  | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[1m%-14s\033[0m %s\n", $$1, $$2}'

## ---------------------------------------------------------------------------
## Environment
## ---------------------------------------------------------------------------

setup: ## Create the pip venv (py3.11), install pinned deps + the package
	$(PYTHON) -m venv $(VENV)
	$(PY) -m pip install --upgrade pip setuptools wheel
	$(PY) -m pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt
	$(PY) -m pip install -e . --no-deps
	@$(MAKE) --no-print-directory check-env

setup-mfa: ## Create the separate `mfa` conda env and download its models
	conda env create -f environment.mfa.yml || conda env update -f environment.mfa.yml
	conda run -n $(MFA_ENV) mfa model download acoustic english_us_arpa
	conda run -n $(MFA_ENV) mfa model download dictionary english_us_arpa
	conda run -n $(MFA_ENV) mfa version

check-env: ## Verify the package imports and report tool versions
	$(PY) -c "import rostrum; print('rostrum', rostrum.__version__)"
	$(PY) -c "from rostrum import load_config; c = load_config(); print('config hash', c.hash[:12])"
	@command -v ffmpeg >/dev/null 2>&1 \
	  && ffmpeg -version | head -1 \
	  || echo "WARNING: ffmpeg not on PATH - 'make data' needs it for decoding/resampling"
	@conda run -n $(MFA_ENV) mfa version 2>/dev/null \
	  || echo "WARNING: conda env '$(MFA_ENV)' not found - run 'make setup-mfa' before 'make data'"

lock: ## Re-resolve requirements.in into the pinned requirements.txt
	$(PY) -m pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.in
	@{ \
	  echo "# Generated by 'make lock' - do not edit by hand."; \
	  echo "# Source: requirements.in | Python: $$($(PY) -V 2>&1)"; \
	  echo "# torch is the CPU build: --extra-index-url https://download.pytorch.org/whl/cpu"; \
	  $(PY) -m pip freeze --exclude-editable; \
	} > requirements.txt
	@echo "wrote requirements.txt"

## ---------------------------------------------------------------------------
## Dataset
## ---------------------------------------------------------------------------

mfa-version: ## Print the installed MFA version and available model names
	@conda run -n $(MFA_ENV) mfa version
	@conda run -n $(MFA_ENV) mfa model list acoustic
	@conda run -n $(MFA_ENV) mfa model list dictionary

smoke-align: ## Align dataset_sample/smoke/<id>.wav and print the first 10 words
	$(PY) scripts/smoke_align.py

data: download provenance build-clean align align-report inject qc annotate-import package ## Download -> preprocess -> align -> inject -> QC -> labels -> package

download: ## Fetch dataset/SOURCES.yaml -> dataset/audio/raw + LICENSES.csv (exit 2 = fields still TODO)
	$(PY) scripts/download_sources.py

provenance: ## Fail if any dataset audio lacks a LICENSES.csv row or a saved licence statement
	$(PY) scripts/check_provenance.py

build-clean: ## Preprocess raw -> dataset/audio/clean (16 kHz mono, -23 LUFS, -1 dBFS peak)
	$(PY) scripts/build_clean.py

align: ## Force-align every clean WAV with MFA -> dataset/alignments/*.TextGrid
	$(PY) scripts/align_clean.py

align-report: ## Per-file alignment QC; fails if any file exceeds the unaligned-word budget
	$(PY) scripts/align_report.py

inject: ## Inject graded flaws -> dataset/audio/injected + labels/*.json + events.tsv
	$(PY) scripts/build_injected.py

qc: ## Realism gates (re-align + UTMOS) -> dataset/qc/* + dataset/qc/summary.md
	$(PY) scripts/qc_dataset.py
	$(PY) scripts/qc_report.py

qc-report: ## Rebuild dataset/qc/summary.md from the existing QC CSVs (no MFA, no UTMOS)
	$(PY) scripts/qc_report.py

annotate-prepare: ## Align human takes -> dataset/annotation/todo/<annotator>/*.TextGrid (empty flaws tier)
	$(PY) scripts/annotate_prepare.py --annotators $(ANNOTATORS)

annotate-import: ## Completed Praat flaw tiers -> dataset/labels/*.json (origin human) + events.tsv
	-$(PY) scripts/annotate_import.py

package: ## Manifest + LOTO splits + datasheet + checksums + dataset_sample/ + dist/ zip
	$(PY) scripts/package_dataset.py

package-check: ## Verify provenance, splits and checksums without writing anything
	$(PY) scripts/package_dataset.py --check

annotate-agreement: ## Inter-annotator event-F1 @ 200 ms + Cohen's kappa -> dataset/qc/agreement.md
	-$(PY) scripts/annotator_agreement.py

features: ## Cache acoustic features for every dataset file (prints s per minute of audio)
	$(PY) scripts/build_features.py $(FEATURE_ARGS)

features-sample: ## Same, over dataset_sample/ only
	$(PY) scripts/build_features.py --sample $(FEATURE_ARGS)

feature-demo: ## F0 (st), energy and rate for one reading -> docs/figures/*.png
	$(PY) scripts/feature_demo.py $(DEMO_ARGS)

envelope: ## Build per-text envelopes + detect (training folds only)
	$(PY) -m scripts.detect_report --source dataset

envelope-synthetic: ## Same chain on generated feature tables (no MFA needed)
	$(PY) -m scripts.detect_report --source synthetic

tuning: ## Fit tau_in/tau_out/penalty per fold -> results/tuning.json
	$(PY) -m scripts.detect_report --source synthetic --write-tuning

classifier: ## Fit the per-fold flaw-type classifier; macro-F1 + docs/figures/confusion_matrix.png
	$(PY) -m scripts.clf_report --out results/classifier.json

rubric: ## Calibrate k_c per fold and print the clean/L1-L4 category scores
	$(PY) -m scripts.score_report --out results/rubric_demo.json

cards: ## Render explanation cards from five different labels -> results/cards_demo.json
	$(PY) -m scripts.cards_demo --out results/cards_demo.json

## ---------------------------------------------------------------------------
## Evaluation
## ---------------------------------------------------------------------------

components: ## Component-validity checks (pitch/alignment/rate) -> results/components.json
	$(PY) -m eval.components $(COMPONENT_ARGS)

eval: ## Leave-one-text-out evaluation -> results/metrics.json + metrics.md
	$(PY) -m eval.run_loto --out results/metrics.json $(EVAL_ARGS)

ablations: ## Ablation table (spec 14.2) -> results/ablations.json + ablations.md
	$(PY) -m eval.ablations --out results/ablations.json $(EVAL_ARGS)

figures: ## Render docs/figures/* (PNG 200 dpi + SVG) from results/metrics.json
	$(PY) -m eval.figures --out docs/figures

failures: ## Three largest misses with suspected causes -> results/failures.md
	$(PY) -m eval.failures --out results/failures.md

## ---------------------------------------------------------------------------
## Serving
## ---------------------------------------------------------------------------

app: ## Streamlit dashboard on :$(PORT_APP) (runs the pipeline in-process)
	$(BIN)/streamlit run app/streamlit_app.py --server.port $(PORT_APP) 	    --server.headless true --browser.gatherUsageStats false

app-remote: ## Dashboard on :$(PORT_APP) talking to the API on :$(PORT_API)
	ROSTRUM_API_URL=http://127.0.0.1:$(PORT_API) $(BIN)/streamlit run app/streamlit_app.py 	    --server.port $(PORT_APP) --server.headless true --browser.gatherUsageStats false

api: ## FastAPI service on :$(PORT_API)
	$(BIN)/uvicorn rostrum.api.server:app --host 127.0.0.1 --port $(PORT_API)

api-docs: ## Print the OpenAPI schema (no server needed)
	$(PY) -c "import json, rostrum.api.server as s; print(json.dumps(s.app.openapi(), indent=2))"

dashboard-figures: ## Render the dashboard's own figures into docs/figures
	$(PY) -m scripts.dashboard_figures --out docs/figures

demo: ## One analysis per operating mode -> results/examples/*.json
	$(PY) -m scripts.analyze_examples

examples: ## Same, and also attempt a dataset_sample file with MFA (needs the mfa env)
	$(PY) -m scripts.analyze_examples --dataset

## ---------------------------------------------------------------------------
## Quality
## ---------------------------------------------------------------------------

test: ## Run the test suite
	$(PY) -m pytest

lint: ## ruff + black --check
	$(PY) -m ruff check $(SRC)
	$(PY) -m black --check $(SRC)

format: ## Apply ruff --fix and black
	$(PY) -m ruff check --fix $(SRC)
	$(PY) -m black $(SRC)

## ---------------------------------------------------------------------------
## Reproduce everything
## ---------------------------------------------------------------------------

reproduce: ## Regenerate every number in the report from raw data, deterministically
	$(MAKE) data
	$(MAKE) features
	$(MAKE) envelope
	$(MAKE) eval
	$(MAKE) ablations
	$(MAKE) failures
	$(MAKE) figures
	@echo "TODO(phase7): $(PY) -m eval.metrics --determinism --runs 2 --out results/determinism.json"

clean-cache: ## Drop cached features/envelopes/models
	rm -rf .cache

clean: clean-cache ## Also drop build artefacts and test caches
	rm -rf build dist .pytest_cache .ruff_cache src/*.egg-info
	find . -name __pycache__ -type d -prune -not -path "./$(VENV)/*" -exec rm -rf {} +
